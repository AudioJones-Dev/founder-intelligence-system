{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strategic Opportunity",
  "type": "object",
  "required": ["id", "source", "thesis", "frameworks_applied", "scores"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique opportunity identifier"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["transcript", "interview", "memo", "market_observation", "founder_brief"]
        },
        "reference": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      }
    },
    "thesis": {
      "type": "string",
      "description": "One-paragraph strategic thesis"
    },
    "market_shift": {
      "type": "string",
      "description": "The underlying shift creating the opportunity"
    },
    "frameworks_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "framework_id": { "type": "string" },
          "finding": { "type": "string" },
          "score": { "type": "number", "minimum": 1, "maximum": 10 }
        }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "golden_opportunity": { "type": "number", "minimum": 1, "maximum": 10 },
        "moat_strength": { "type": "number", "minimum": 1, "maximum": 10 },
        "timing_asymmetry": { "type": "number", "minimum": 1, "maximum": 10 }
      }
    },
    "moat_potential": { "type": "string" },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendation": { "type": "string" },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
